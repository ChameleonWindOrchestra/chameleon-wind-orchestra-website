# MicroCMS connection (#23 / #24)
# Service domain is the prefix of `https://<domain>.microcms.io`.
# For this project: chameleon-wind-orchestra
MICROCMS_SERVICE_DOMAIN=chameleon-wind-orchestra

# API key issued from the MicroCMS admin console (Service settings → API keys).
# Use a key with read-only permissions on all 4 APIs (concerts / members / news / heroImages).
MICROCMS_API_KEY=

# Web3Forms access key for the Contact form (#30 / #74).
# Sign up at https://web3forms.com/, register chameleon.wind70@gmail.com,
# and paste the access key issued by Web3Forms here.
# This is intentionally NEXT_PUBLIC_* because Web3Forms expects the key to
# be sent from the browser — the key is scoped to one destination email and
# can be rotated freely from the Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
